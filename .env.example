# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Spotify Developer Application Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Headless / Cloud Hosting (e.g. Bot-Hosting.net, Railway, VPS)
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# Optional: Custom path to ffmpeg executable (if not automatically discovered)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Optional performance tuning
# SPOTIFY_POLL_SECONDS=10
# MAX_VOICE_STREAMS=2

# --- YouTube / yt-dlp ---
# Cookies are only a last resort. A signed-in session makes yt-dlp drop the
# "visionos" client, and YouTube then serves SABR/image streams with no audio.
# Netscape-format cookies from a THROWAWAY Google account only:
# YTDLP_COOKIES_FILE=cookies.txt
# Or paste the whole cookies.txt contents base64-encoded (single line):
# YTDLP_COOKIES_B64=
# Cookie policy: auto (default) = only use cookies when no proxy is set.
# always | never
# YTDLP_USE_COOKIES=auto
# Force IPv4. Helps when the host's IPv6 range is distrusted. Default: true
# YTDLP_FORCE_IPV4=true
# Optional player-client override (comma-separated), e.g. tv_samsung,visionos,web_embedded
# Tried first, but the bot still falls back to anonymous "visionos" and then
# cookie-based clients, so a stale value cannot cause "Requested format is not
# available" permanently. Leave empty unless debugging.
# YTDLP_PLAYER_CLIENT=
#
# --- Proxy (the reliable fix when YouTube blocks the host IP) ---
# Must have an HTTP listener: FFmpeg cannot use SOCKS and does not send proxy
# credentials. Local unauthenticated listeners (e.g. Cloudflare WARP via
# wireproxy) work best. See README "YouTube bot check".
# YTDLP_PROXY=http://127.0.0.1:25344
# Defaults to YTDLP_PROXY. Set only if FFmpeg should use a different listener.
# FFMPEG_PROXY=

# Note for cloud panels: set these as panel environment variables (not here),
# because pip runs before the bot loads .env:
#   PIP_NO_CACHE_DIR=1
#   PYTHONDONTWRITEBYTECODE=1
#   MALLOC_ARENA_MAX=2
